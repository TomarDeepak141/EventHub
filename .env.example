# Copy this file to .env for local use only. Generate a JWT value before startup;
# never commit a populated .env file or reuse a development key in production.
POSTGRES_DB=eventhub
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
HTTP_PORT=8088
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
SEAT_RESERVATION_TTL=PT5M
CORS_ALLOWED_ORIGINS=
# Optional fictional catalog seeding. The application creates 24 events only when true.
SEED_DEMO_CATALOG=false
# Optional: promotes only this already-registered active account to ADMIN; leave blank by default.
ADMIN_BOOTSTRAP_EMAIL=
